{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YomiMado",
  "version": "0.7.0",
  "identifier": "com.yomimado.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "YomiMado — Settings",
        "width": 700,
        "height": 480,
        "resizable": true,
        "decorations": true,
        "visible": false
      },
      {
        "label": "toolbar",
        "title": "YomiMado toolbar",
        "url": "index.html?mode=toolbar",
        "width": 580,
        "height": 56,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
