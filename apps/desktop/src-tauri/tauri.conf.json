{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YomiMado",
  "version": "0.1.0",
  "identifier": "com.yomimado.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "YomiMado",
        "width": 700,
        "height": 480,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": [] }
}
